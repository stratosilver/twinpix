<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio project for TwinPix, in src\TwinPix\ as .NET projects
  usually are; the solution (TwinPix.sln) sits at the root of the
  repository, with the build scripts and the documentation.

  It exists so the Windows Forms designer can open MainForm.cs and
  FileCard.cs on the design surface; build.bat still builds the very same
  sources with the compiler shipped with Windows, and needs none of this.
  A new .cs file must be added below as well (build.bat takes the *.cs of
  this folder and of Properties\ on its own).

  The WIC constant and the three WPF references below are what enable the
  fast image decoder used by visual matching. If those assemblies are not
  installed with your targeting pack, remove "WIC" from DefineConstants
  and the three references: the build then falls back to GDI+, exactly as
  "build.bat nowic" does.
-->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{2A66C9A0-0C40-4E5D-8D70-A0FD4C0F0A91}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>TwinPix</RootNamespace>
    <AssemblyName>TwinPix</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <!-- The icon and the manifest are shared with build.bat, in assets\ at the root. -->
    <ApplicationIcon>..\..\assets\twinpix.ico</ApplicationIcon>
    <ApplicationManifest>..\..\assets\TwinPix.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- build.bat uses the csc.exe shipped with Windows, which only knows C# 5.
         Visual Studio is held to the same version, so that code written there
         always builds with build.bat too. See DEVELOPER.md. -->
    <LangVersion>5</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE;WIC</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE;WIC</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>
  <ItemGroup>
    <!-- One class per file; build.bat compiles the same files. The map is in DEVELOPER.md. -->
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="DupGroup.cs" />
    <Compile Include="DuplicateRemover.cs" />
    <Compile Include="FileEntry.cs" />
    <Compile Include="FileIdentity.cs" />
    <Compile Include="Fingerprint.cs" />
    <Compile Include="FingerprintCache.cs" />
    <Compile Include="FolderHistory.cs" />
    <Compile Include="FolderWalker.cs" />
    <Compile Include="Format.cs" />
    <Compile Include="GroupComparer.cs" />
    <Compile Include="ImageHash.cs" />
    <Compile Include="KeepRule.cs" />
    <Compile Include="KeepSelector.cs" />
    <Compile Include="MatchMode.cs" />
    <Compile Include="Native.cs" />
    <Compile Include="NativeMethods.cs" />
    <Compile Include="PathHelper.cs" />
    <Compile Include="RecycleBin.cs" />
    <Compile Include="RemovalItem.cs" />
    <Compile Include="RemovalJournal.cs" />
    <Compile Include="RemovalOutcome.cs" />
    <Compile Include="RemovalSettings.cs" />
    <Compile Include="ScanOptions.cs" />
    <Compile Include="ScanResult.cs" />
    <Compile Include="ScannedFolder.cs" />
    <Compile Include="Scanner.cs" />
    <Compile Include="Shell.cs" />
    <Compile Include="Thumbnail.cs" />
    <Compile Include="UiStyle.cs" />
    <Compile Include="VisualMatcher.cs" />
    <Compile Include="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <Compile Include="FileCard.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Include="FileCard.Designer.cs">
      <DependentUpon>FileCard.cs</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="FileCard.resx">
      <DependentUpon>FileCard.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\twinpix.ico">
      <Link>assets\twinpix.ico</Link>
      <LogicalName>TwinPix.twinpix.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\assets\TwinPix.manifest">
      <Link>assets\TwinPix.manifest</Link>
    </None>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
